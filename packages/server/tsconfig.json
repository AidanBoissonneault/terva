{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "../../",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "types": [],
    "paths": {
      "@terva/shared": ["../shared/src/index.ts"],
      "@terva/shared/*": ["../shared/src/*"]
    },
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "../../shared/src", "../../email/src"]
}